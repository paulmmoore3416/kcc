# Kraken Cloud Control - standalone (no Kubernetes) settings.
# Copy to ~/.config/kcc/kcc.env and edit. Never commit the real file.

# REST API for the dashboard. Keep it on loopback unless you add auth in front of it.
KCC_HTTP_ADDR=127.0.0.1:8080
KCC_GRPC_HOST=127.0.0.1
KCC_CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200

# Mining rig feed (kcc.mining/v1). "off" disables the Mining Ops module.
KCC_MINING_URL=http://127.0.0.1:8420/api/kcc/v1
KCC_MINING_POLL=10s

# AI provider. On a GPU-mining rig, Ollama can evict the miner from VRAM: keep it on CPU
# or only use the AI assistant outside mining hours.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:latest
# GEMINI_API_KEY=            # set here, never in the repository

# Optional DePIN account identifiers
# OPTIMAI_ACCOUNT=
